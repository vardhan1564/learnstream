# Copy this file to secrets.properties (project root, next to pom.xml) and fill in your values.
# secrets.properties is git-ignored, so your passwords never end up on GitHub.
# On a hosting provider, set the same values as environment variables instead
# (DB_URL, DB_USERNAME, DB_PASSWORD, MAIL_USERNAME, MAIL_PASSWORD, JWT_SECRET, ...).

spring.datasource.username=root
spring.datasource.password=your-mysql-password

spring.mail.username=your-gmail@gmail.com
# Gmail App Password (Google Account > Security > App passwords), not your normal password
spring.mail.password=your-16-char-app-password

learnstream.jwt.secret=paste-output-of-openssl-rand-hex-32-here

learnstream.admin.email=admin@learnstream.com
learnstream.admin.password=ChangeMe@123

stripe.api.key=sk_test_xxx

# ---- Video uploads ----
# Local disk (default, good for development):
# learnstream.storage.type=local
# Cloudflare R2 (recommended when hosting). Create a bucket + an R2 API token, then:
# learnstream.storage.type=s3
# learnstream.storage.s3.endpoint=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# learnstream.storage.s3.region=auto
# learnstream.storage.s3.bucket=learnstream-videos
# learnstream.storage.s3.access-key=...
# learnstream.storage.s3.secret-key=...

# ---- Hosting ----
# Send OTP emails through Brevo's HTTPS API instead of SMTP (needed on Render's free tier, which blocks SMTP).
# On Render set the env var BREVO_API_KEY. spring.mail.username must be a verified sender in Brevo.
# learnstream.mail.brevo-api-key=xkeysib-...
# Header holding the real client IP for rate limiting. Only set it behind a proxy that overwrites it.
# On Render (Cloudflare in front) use CF-Connecting-IP. Leave unset locally.
# learnstream.client-ip-header=CF-Connecting-IP
